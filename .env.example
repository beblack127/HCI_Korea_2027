# 실제 키를 입력하고 서버를 재시작하세요. 키는 브라우저로 전달되지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_STYLE=generate_content
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_SECONDS=300
# auto: 키가 있으면 Gemini, 없으면 규칙/템플릿 미리보기. preview: 항상 미리보기.
APP_MODE=auto
PORT=5109
DATA_DIR=data
SESSION_COOKIE_SECURE=false
STUDY_ACCESS_CODE=

# OpenAlex는 공개 검색을 먼저 시도합니다. 인증/사용한도에 걸리면 키를 추가하세요.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
